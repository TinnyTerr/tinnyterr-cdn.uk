{
	"compilerOptions": {
		"target": "es2016",
		"module": "commonjs",
		"rootDir": "./public",
		"declaration": true,
		"sourceMap": true,
		"outDir": "./public",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"exclude": ["dist", "node_modules", "src", "*.html", "*.css"]
}
